# Client-side (safe to expose)
VITE_GOOGLE_CLIENT_ID=

# Server-side only (DO NOT expose to the browser)
GEMINI_API_KEY=

# Database (server-side only) - for login/logout audit events
# Works with Vercel Postgres or any Postgres provider
DATABASE_URL=

# Optional security tightening
ALLOWED_GOOGLE_DOMAIN=
ALLOWED_GOOGLE_EMAILS=

# Optional model override
GEMINI_MODEL=
